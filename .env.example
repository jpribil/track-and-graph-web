# Required for Docker Compose; change it before exposing the application.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional: creates the first administrator on application start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-starting

# Set false after the initial accounts have been created.
ALLOW_REGISTRATION=true

# Use a public HTTPS URL when deployed behind a reverse proxy.
APP_ORIGIN=http://localhost:3080
